{
  "name": "ecostan-admin",
  "version": "1.0.0",
  "description": "EcoSTAN · Panel de Administración",
  "author": "Territorio Cívico S.A.S.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "co.territoriocivico.ecostan.admin",
    "productName": "EcoSTAN Admin",
    "copyright": "© 2026 EcoStan - Territorio Cívico S.A.S.",
    "files": ["main.js", "www/**/*", "build/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
